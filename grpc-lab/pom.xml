<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.myxhs.grpc</groupId>
    <artifactId>grpc-lab</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>grpc-lab</name>
    <description>gRPC 学习实验沙箱：与 gRPC-Java 1.83.1 源码对齐（面试核心版）</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <grpc.version>1.83.1</grpc.version>
        <protobuf.version>3.25.9</protobuf.version>
        <!-- lab 参数（exec:exec 显式转发；脚本用 -Dlab.xxx=... 覆盖） -->
        <lab.main>com.myxhs.grpc.lab.ServerApp</lab.main>
        <lab.port>50051</lab.port>
        <lab.target>localhost:50051</lab.target>
        <lab.retry>false</lab.retry>
        <lab.hedging>false</lab.hedging>
        <lab.debug.callclass>false</lab.debug.callclass>
        <lab.enable.retry>true</lab.enable.retry>
        <lab.fail.first>0</lab.fail.first>
        <lab.fail.code>UNAVAILABLE</lab.fail.code>
        <lab.server.slow.ms>0</lab.server.slow.ms>
        <lab.server.lifecycle>false</lab.server.lifecycle>
        <lab.echo>false</lab.echo>
        <lab.single>false</lab.single>
        <lab.interceptors>false</lab.interceptors>
        <lab.meta>false</lab.meta>
        <lab.stream></lab.stream>
        <lab.context>false</lab.context>
        <lab.deadline.ms>0</lab.deadline.ms>
        <lab.provider.tag></lab.provider.tag>
        <lab.resolver></lab.resolver>
        <lab.health>false</lab.health>
        <lab.health.wait>false</lab.health.wait>
        <lab.health.flip.ms>0</lab.health.flip.ms>
        <lab.reflection>false</lab.reflection>
        <lab.discovery>0</lab.discovery>
        <lab.lb></lab.lb>
        <lab.graceful.ms>0</lab.graceful.ms>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-util</artifactId>
            <version>${grpc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protobuf.version}</version>
        </dependency>
        <!-- 生成的代码需要 @javax.annotation.Generated -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>compile</goal>
                            <goal>compile-custom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>-Dlab.port=${lab.port}</argument>
                        <argument>-Dlab.target=${lab.target}</argument>
                        <argument>-Dlab.retry=${lab.retry}</argument>
                        <argument>-Dlab.hedging=${lab.hedging}</argument>
                        <argument>-Dlab.debug.callclass=${lab.debug.callclass}</argument>
                        <argument>-Dlab.enable.retry=${lab.enable.retry}</argument>
                        <argument>-Dlab.fail.first=${lab.fail.first}</argument>
                        <argument>-Dlab.fail.code=${lab.fail.code}</argument>
                        <argument>-Dlab.server.slow.ms=${lab.server.slow.ms}</argument>
                        <argument>-Dlab.server.lifecycle=${lab.server.lifecycle}</argument>
                        <argument>-Dlab.echo=${lab.echo}</argument>
                        <argument>-Dlab.single=${lab.single}</argument>
                        <argument>-Dlab.interceptors=${lab.interceptors}</argument>
                        <argument>-Dlab.meta=${lab.meta}</argument>
                        <argument>-Dlab.stream=${lab.stream}</argument>
                        <argument>-Dlab.context=${lab.context}</argument>
                        <argument>-Dlab.deadline.ms=${lab.deadline.ms}</argument>
                        <argument>-Dlab.provider.tag=${lab.provider.tag}</argument>
                        <argument>-Dlab.resolver=${lab.resolver}</argument>
                        <argument>-Dlab.health=${lab.health}</argument>
                        <argument>-Dlab.health.wait=${lab.health.wait}</argument>
                        <argument>-Dlab.health.flip.ms=${lab.health.flip.ms}</argument>
                        <argument>-Dlab.reflection=${lab.reflection}</argument>
                        <argument>-Dlab.discovery=${lab.discovery}</argument>
                        <argument>-Dlab.lb=${lab.lb}</argument>
                        <argument>-Dlab.graceful.ms=${lab.graceful.ms}</argument>
                        <argument>${lab.main}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
