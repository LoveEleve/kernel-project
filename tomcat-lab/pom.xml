<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.myxhs.demo</groupId>
        <artifactId>xhs-demo</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>tomcat-lab</artifactId>
    <name>tomcat-lab</name>
    <description>内嵌 Tomcat 实验室：优雅停机 / 线程模型 / 请求旅程 / Mapper 路由 的可运行复现代码</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- 09 篇：观测 Tomcat 指标（tomcat.threads.busy 等，需 mbeanregistry 打开） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 可 mvn spring-boot:run / 打可执行 jar（版本由父 POM pluginManagement 提供） -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- 父 POM 未管 surefire 版本（Maven 默认 2.12.4 不支持 JUnit5），这里显式用 3.x -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
